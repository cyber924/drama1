# Gemini generation key: configure only as a server secret.
GEMINI_API_KEY=""
# Canonical production origin is fixed in src/lib/site.ts.
APP_URL="https://dramahub.co.kr"
# Set to 1 only after dramahub.co.kr serves this project over HTTPS.
# Preserves old links by redirecting drama1-brown.vercel.app to the new origin.
DRAMA_REDIRECT_LEGACY="0"
