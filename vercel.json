{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/blog/:id",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/blog",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|favicon.ico|.*\\..*).*)",
      "destination": "/api/index"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dramahub.co.kr"
        }
      ],
      "destination": "https://dramahub.co.kr/:path*",
      "permanent": true
    }
  ]
}
